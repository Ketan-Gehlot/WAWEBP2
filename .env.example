APP_ENV=development
APP_NAME=Maxis Gold Jewellery WhatsApp Automation
APP_DEBUG=false

DATABASE_URL=sqlite:///./kap_whatsapp.db

META_GRAPH_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

REDIS_URL=redis://localhost:6379/0

ENABLE_OUTBOUND_MESSAGES=false
DRY_RUN=true
GLOBAL_KILL_SWITCH=false
ACCOUNT_QUALITY_STATUS=GREEN

MAX_MESSAGES_PER_MINUTE=30
MAX_DAILY_MESSAGES=250
META_24H_UNIQUE_RECIPIENT_LIMIT=250
MAX_CAMPAIGN_RECIPIENTS=500

BUSINESS_NAME=Maxis Gold Jewellery
BUSINESS_GREETING=Hello! Welcome to Maxis Gold Jewellery. How can we help you today?
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_TIMEZONE=Asia/Kolkata

ADMIN_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
